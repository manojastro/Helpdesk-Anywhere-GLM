# Helpdesk Anywhere — environment variables.
# Copy to .env and fill in. Never commit a real .env (.gitignore blocks it).
# Every variable below is optional for local development: the defaults shown
# are what the code falls back to when the variable is unset.

# ---------------------------------------------------------------------------
# Backend (apps/backend)
# ---------------------------------------------------------------------------

# HTTP/WebSocket port.
PORT=4000

# JWT signing secret for technician access tokens and session join tokens.
# Local dev falls back to a public, well-known development secret.
# REQUIRED when NODE_ENV=production — the backend refuses to boot without it.
JWT_SECRET=

# PostgreSQL connection string (Cloud SQL). When unset the backend uses SQLite.
# DATABASE_URL=postgresql://helpdesk:password@host:5432/helpdesk?sslmode=require

# SQLite file used when DATABASE_URL is unset. ':memory:' is used by the tests.
SQLITE_PATH=helpdesk.sqlite

# TypeORM auto-schema-sync. On by default in development. When
# NODE_ENV=production it is OFF unless you set this to exactly 'true'.
# This POC has no migrations yet, so a first deploy against an empty database
# needs DB_SYNCHRONIZE=true for one boot — then unset it. It can drop columns
# and data, so never leave it on against a database you care about.
# DB_SYNCHRONIZE=true

# Comma-separated CORS allow-list for REST + socket.io; '*' reflects any origin.
# Unset means: reflect any origin in dev, same-origin only when
# NODE_ENV=production. Set this when the console is served from another origin.
# CORS_ORIGIN=https://console.example.com

# ---- ICE / WebRTC (served to the browser and the agent by GET /config/ice) ---

# STUN server. Defaults to Google's public STUN.
STUN_URL=stun:stun.l.google.com:19302

# TURN servers, comma-separated. Each entry MUST start with turn: or turns:
# — entries with any other scheme are dropped and logged, because a malformed
# URL makes the browser's RTCPeerConnection constructor throw.
# turns: requires a CA-issued certificate on the TURN host; the POC's
# self-signed cert only works for turn:...?transport=tcp.
# TURN_URL=turn:203.0.113.10:3478?transport=tcp,turns:turn.example.com:443?transport=tcp

# Long-term TURN credentials. Must match the coturn `user=` line in
# infra/gcp/coturn/startup.sh.
# TURN_USERNAME=helpdesk
# TURN_CREDENTIAL=

# ---------------------------------------------------------------------------
# Web console (apps/web) — build-time, must be prefixed VITE_
# ---------------------------------------------------------------------------

# Base URL for backend REST calls, and the origin for socket.io.
# Unset (default '/api') = same-origin deployment behind a reverse proxy that
# routes /api and /socket.io to the backend. This is what `npm run dev:web` does.
# Set an absolute URL for a separate backend host; that also requires
# CORS_ORIGIN above.
# VITE_API_BASE=https://backend.example.com

# ---------------------------------------------------------------------------
# Windows endpoint agent (apps/agent) — read from the process environment
# ---------------------------------------------------------------------------

# Target capture frame rate. Default 8.
# HA_FPS=8

# Downscale captured frames to at most this width (bandwidth control).
# Default 1280.
# HA_MAX_WIDTH=1280

# Screen capture backend. Default 'auto': try DXGI Desktop Duplication and fall
# back to GDI (e.g. when RDP makes DXGI return black frames). Set to 'gdi' to
# force the GDI path.
# HA_CAPTURE=auto

# Remote mouse/keyboard injection kill switch. Any value other than '0' leaves
# injection enabled; set exactly '0' to disable it.
# HA_INPUT=1

# Set to exactly '1' to join without publishing a video track
# (signalling/DataChannel/chat only). Any other value streams video.
# HA_NO_VIDEO=0

# The agent reads the same ICE settings as the backend: STUN_URL, TURN_URL,
# TURN_USERNAME, TURN_CREDENTIAL (see above).
#
# NOTE: the agent passes TURN_URL straight through as a single RTCIceServer
# 'urls' value, while the backend splits it on commas for the browser. If you
# use a comma-separated TURN_URL, verify the agent accepts that form before
# relying on it, or give the agent a single TURN URL.
